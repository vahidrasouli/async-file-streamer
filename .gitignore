# ==========================================
# 1. Sensitive Data & Sessions (بسیار مهم)
# ==========================================
# جلوگیری از آپلود سشن‌های روبیکا و اطلاعات اکانت
*.rp
time_sessions.rp
time_sessions/
sessions/
*.db
*.sqlite
*.sqlite3

# ==========================================
# 2. Large Media & Archive Files (فایل‌های حجیم)
# ==========================================
# جلوگیری از آپلود ویدیوهای دانلود یا ادغام شده و فایل‌های زیپ
*.mp4
*.avi
*.mkv
*.zip
*.rar
*.tar.gz

# ==========================================
# 3. Python Cache & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.log

# =========================
# Virtual Environments
# =========================
.env
.env.*
venv/
env/
.venv/
ENV/

